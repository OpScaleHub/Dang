<?xml version="1.0" encoding="utf-8"?>
<!-- Financial and resident data is excluded from automatic cloud backup and device transfer.
     Users back up explicitly through the in-app backup file (Storage Access Framework). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
